    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Division_of_Labour -->

    <owl:Class rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Division_of_Labour">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#isPerformedBy"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Community"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#isPerformedBy"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#isPerformedBy"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Subject"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <osmethodology:natural_language_description>The way the tasks are divided up and the way roles and hierarchies are structured. Division of Labour is performed by community, subject and object.  [Engeström, Miettinnen et al. 1999]</osmethodology:natural_language_description>
        <osmethodology:related_rabbit_sentence>Division of Labour is a concept.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Division of Labour is performed by Community.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Division of Labour is performed by Object.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Division of Labour is performed by Subject.</osmethodology:related_rabbit_sentence>
        <rdfs:label xml:lang="en">Division of Labour</rdfs:label>
        <rdfs:label xml:lang="en">Hierarchical Structure</rdfs:label>
        <rdfs:label xml:lang="en">Hierarchy</rdfs:label>
        <rdfs:label xml:lang="en">Roles Structure</rdfs:label>
        <rdfs:label xml:lang="en">Task Division</rdfs:label>
    </owl:Class>
    


