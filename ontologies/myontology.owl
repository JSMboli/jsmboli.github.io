    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Subject -->

    <owl:Class rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Subject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Group"/>
                            <rdf:Description rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Person"/>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#undertake"/>
                        <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Activity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#interactWith"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Community"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#subjectUsesTool"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Tool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#interactWith"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#subjectHasMotivation"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Motivation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <osmethodology:natural_language_description>The individual of group who undertakes the activity. [Stan Karanasios]</osmethodology:natural_language_description>
        <osmethodology:related_rabbit_sentence>A Subject is anything that:
  is a kind of Individual or Group;
  undertakes an Activity.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Subject has at least one Motivation.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Subject interacts with Community.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Subject interacts with at least one Object.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Subject uses Tools.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Subject is a concept.</osmethodology:related_rabbit_sentence>
        <rdfs:label xml:lang="en">Subject</rdfs:label>
    </owl:Class>
    


