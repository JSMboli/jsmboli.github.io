    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Emotion -->

    <owl:Class rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Emotion">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#isEmbeddedIn"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Activity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#isEmbeddedIn"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Motivation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#isEmbeddedIn"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Operation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <osmethodology:natural_language_description>Complex systems, that constitute the motivational system of human beings, developed through the course of human evolution to preapre an organism to act in response to environmental stimuli and challenges.  [Izzard 1997]</osmethodology:natural_language_description>
        <osmethodology:natural_language_description>Emotion and activity are interrelated [Stan Karanasios]</osmethodology:natural_language_description>
        <osmethodology:related_rabbit_sentence>Emotion is a concept.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Emotion usually is related to Action.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Emotion usually is related to Activity.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Emotion usually is related to Operation.</osmethodology:related_rabbit_sentence>
        <rdfs:label xml:lang="en">Emotion</rdfs:label>
        <rdfs:label xml:lang="en">Emotions</rdfs:label>
    </owl:Class>
    


