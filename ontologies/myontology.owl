    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Rule_Norm -->

    <owl:Class rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Rule_Norm">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#ruleNormGovern"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Community"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#ruleNormGovern"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#ruleNormGovern"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Subject"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <osmethodology:natural_language_description xml:lang="en">Regulations, Norms and Conventions (explicit and implicit) that constrain activity. [Engeström, Miettinnen et al. 1999]</osmethodology:natural_language_description>
        <osmethodology:natural_language_description>Rules &amp; Norms govern Community, Subject and Object. [Stan Karanasios]</osmethodology:natural_language_description>
        <osmethodology:related_rabbit_sentence>Every Rules &amp; Norms govern Community.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Rules &amp; Norms govern Object.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Rules &amp; Norms govern Subject.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Rules &amp; Norms is a concept.</osmethodology:related_rabbit_sentence>
        <rdfs:label xml:lang="en">Conventions</rdfs:label>
        <rdfs:label xml:lang="en">Norm</rdfs:label>
        <rdfs:label xml:lang="en">Norm (social)</rdfs:label>
        <rdfs:label xml:lang="en">Norms</rdfs:label>
        <rdfs:label xml:lang="en">Regulations</rdfs:label>
        <rdfs:label xml:lang="en">Regulations, Norms and Conventions</rdfs:label>
        <rdfs:label xml:lang="en">Rules &amp; Norms</rdfs:label>
    </owl:Class>
    


