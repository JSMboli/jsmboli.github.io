    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Action -->

    <owl:Class rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Action">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#hasGoal"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#hasOperation"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Operation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#isPartOfActivity"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Activity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <osmethodology:natural_language_description>Goal orientated actions that contributes to the attainment of the motive for the activity.  [Engeström, Miettinnen et al. 1999]</osmethodology:natural_language_description>
        <osmethodology:related_rabbit_sentence>Action is a concept.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Action has Goal.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Action has Operation.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Action is part of Activity.</osmethodology:related_rabbit_sentence>
        <rdfs:label>Action</rdfs:label>
    </owl:Class>
    


    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Activity -->

    <owl:Class rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Activity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#activityHasMotivation"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Motivation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#hasAction"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#hasDivisionOfLabour"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Division_of_Labour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#hasOutcome"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Outcome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#hasRuleNorm"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Rule_Norm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#isDefinedBy"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Activity_Viewpoint"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#isViewpointOf"/>
                                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Subject"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#hasObject"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#hasSubject"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Subject"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#hasTool"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Tool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <osmethodology:natural_language_description>It&apos;s a human, individual or collective activity driven by a motive. Every activity has rules and norms, division of labour, tools, a subject, object and community and an outcome. [Stan Karanasios]</osmethodology:natural_language_description>
        <osmethodology:related_rabbit_sentence>Activity is a concept.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Activity has Division of Labour.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Activity has Motivation.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Activity has Outcome.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Activity has Rules &amp; Norms.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Activity has at least one Object.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Activity has at least one Subject.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Activity has at least one Tool.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Activity is defined by a Activity Viewpoint that is viewpoint of Subject.</osmethodology:related_rabbit_sentence>
        <rdfs:label xml:lang="en">Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Activity_Viewpoint -->

    <owl:Class rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Activity_Viewpoint">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#isViewpointOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Subject"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <osmethodology:related_rabbit_sentence>Activity Viewpoint is a concept.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Activity Viewpoint is viewpoint of  exactly one Subject.</osmethodology:related_rabbit_sentence>
        <rdfs:label xml:lang="en">Activity Viewpoint</rdfs:label>
    </owl:Class>
    


