<?xml version="1.0"?>
<rdf:RDF xmlns="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#"
     xml:base="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:myontology="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#"
     xmlns:osmethodology="http://www.ordnancesurvey.co.uk/ontologies/osmethodology/1.0/">
    <owl:Ontology rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl">
        <owl:imports rdf:resource="http://imash.leeds.ac.uk/ontologies/amon/SentiWordNet.owl"/>
        <dc:creator xml:lang="en">Dhavalkumar Thakker
Stan Karanasios
Ronald Denaux
Vania Dimitrova</dc:creator>
        <dc:date xml:lang="en">27/04/2011</dc:date>
        <osmethodology:knowledge_source>Dhaval</osmethodology:knowledge_source>
        <osmethodology:knowledge_source>Engeström, Miettinnen et al. 1999</osmethodology:knowledge_source>
        <osmethodology:knowledge_source>Izzard 1997</osmethodology:knowledge_source>
        <osmethodology:knowledge_source>Kring and Stuart 2005</osmethodology:knowledge_source>
        <osmethodology:knowledge_source>Leontev 1978</osmethodology:knowledge_source>
        <osmethodology:knowledge_source>Stan Karanasios</osmethodology:knowledge_source>
        <osmethodology:purpose>Aims to structure and define an activity model.</osmethodology:purpose>
        <osmethodology:scope>Includes the main concept of an activity following Activity Theory.</osmethodology:scope>
        <owl:versionInfo xml:lang="en">1.1</owl:versionInfo>
        <owl:versionInfo>Brought the naming conventions inline with the standard practice.</owl:versionInfo>
        <owl:versionInfo xml:lang="en">added proxemics instances (that were not supplied by DE) </owl:versionInfo>
        <owl:versionInfo xml:lang="en">expanded paralanguage instances (not from DE)</owl:versionInfo>
    </owl:Ontology>
    


