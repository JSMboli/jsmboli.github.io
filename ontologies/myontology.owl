    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Community -->

    <owl:Class rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Community">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Group"/>
                    <rdf:Description rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#communityInfluence"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#communityInfluence"/>
                <owl:someValuesFrom rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Subject"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Subject"/>
        <osmethodology:natural_language_description>Community influences Subject and Object. [Stan Karanasios]</osmethodology:natural_language_description>
        <osmethodology:natural_language_description>Individuals or groups other than the subject who have some general objects and with whom the subject interacts.  [Engeström, Miettinnen et al. 1999]</osmethodology:natural_language_description>
        <osmethodology:related_rabbit_sentence>Community and Subject are mutually exclusive.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Community is a concept.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Community influences Object.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Community influences Subject.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>Every Community is a kind of Individual or Group.</osmethodology:related_rabbit_sentence>
        <rdfs:label xml:lang="en">Community</rdfs:label>
    </owl:Class>
    


    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Components -->

    <owl:Class rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Components">
        <rdfs:subClassOf rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#New_Product"/>
