    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#activityHasMotivation -->

    <owl:ObjectProperty rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#activityHasMotivation">
        <rdfs:domain rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Activity"/>
        <rdfs:range rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Motivation"/>
    </owl:ObjectProperty>
    


    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#communityInfluence -->

    <owl:ObjectProperty rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#communityInfluence">
        <owl:inverseOf rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#influenceByCommunity"/>
        <rdfs:domain rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Community"/>
        <rdfs:range rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Subject"/>
        <osmethodology:related_rabbit_sentence>The Relationship influences is the inverse of influenced by.</osmethodology:related_rabbit_sentence>
        <osmethodology:related_rabbit_sentence>influences is a relationship.</osmethodology:related_rabbit_sentence>
        <rdfs:label>influences</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#deintensify -->

    <owl:ObjectProperty rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#deintensify">
        <osmethodology:related_rabbit_sentence>deintensifies is a relationship.</osmethodology:related_rabbit_sentence>
        <rdfs:label>deintensifies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#hasAction -->

