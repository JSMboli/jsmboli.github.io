    <!-- https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Cost -->

    <owl:Class rdf:about="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Cost">
        <rdfs:subClassOf rdf:resource="https://jsmboli.github.io/jsmboli/ontologies/myontology.owl#Components"/>
